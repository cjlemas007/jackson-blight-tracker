{
  "name": "jackson-blight-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs && node scripts/fetch-models.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-maplibre-worker.mjs && node scripts/fetch-models.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d db",
    "db:migrate": "tsx db/migrate.ts",
    "sync": "tsx sync/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "staff": "tsx scripts/staff.ts",
    "photos:process": "tsx scripts/process-photos.ts",
    "models": "node scripts/fetch-models.mjs",
    "detect": "tsx scripts/detect-folder.ts",
    "dev:demo": "tsx scripts/dev-demo.ts"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^9.6.1",
    "exifr": "^7.1.3",
    "maplibre-gl": "^6.18.0",
    "next": "16.4.6",
    "onnxruntime-web": "^1.31.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@netlify/functions": "^6.1.1",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}

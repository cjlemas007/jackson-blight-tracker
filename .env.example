# Local PostGIS from docker-compose (port 54329 to avoid clashing with other Postgres installs)
DATABASE_URL=postgres://blight:blight@localhost:54329/blight
TEST_DATABASE_URL=postgres://blight:blight@localhost:54329/blight_test

# BigQuery source (uses Application Default Credentials: `gcloud auth application-default login`)
BQ_PROJECT=wlbt-projects
BQ_DATASET=property_tax

# Local development only: password for `npm run staff -- dev-accounts`
DEV_STAFF_PASSWORD=

# Photo storage. Unset = local disk at LOCAL_STORAGE_DIR (default ./storage).
# Production (Supabase Storage, buckets photos-private and photos-public):
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# LOCAL_STORAGE_DIR=./storage

# Production photo processing: Netlify background function URL + shared secret.
# Unset = process in-process after the response (development).
# PHOTO_WORKER_URL=
# PHOTO_WORKER_SECRET=

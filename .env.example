# Local PostGIS from docker-compose (port 54329 to avoid clashing with other Postgres installs)
DATABASE_URL=postgres://blight:blight@localhost:54329/blight
TEST_DATABASE_URL=postgres://blight:blight@localhost:54329/blight_test

# BigQuery source (uses Application Default Credentials: `gcloud auth application-default login`)
BQ_PROJECT=wlbt-projects
BQ_DATASET=property_tax
